{
  "account": "ibny",
  "backupAccount": null,
  "model": "gemini-4-hydrogen",
  "modelFallbacks": [],
  "accounts": {
    "strategy": "on-failure",
    "backups": [],
    "rotateModels": true
  },
  "chunking": {
    "enabled": true,
    "maxMinutes": 120,
    "ceilingMinutes": 150,
    "genTimeoutMin": 20,
    "watchdogMin": 26,
    "retryAttempts": 2,
    "slidesMaxPages": 40,
    "slidesMaxMB": 12
  },
  "minNoteChars": 400,
  "jobs": 1,
  "windowMode": null,
  "genTimeoutMin": 10,
  "retry": {
    "attempts": 3,
    "baseDelayMs": 5000,
    "maxDelayMs": 60000
  },
  "archive": {
    "enabled": true,
    "folder": "Classes",
    "bySubject": false
  },
  "reuse": true,
  "resume": true,
  "slides": {
    "enabled": true,
    "root": null
  },
  "notion": {
    "enabled": true
  },
  "audioClean": {
    "enabled": false,
    "loudnessTarget": -16
  },
  "history": {
    "enabled": true,
    "dir": "./state"
  },
  "counters": {
    "enabled": true
  }
